# RTX GPU 部署：让普通 `docker compose up` 自动叠加 GPU override。
# CPU 主机请删除本行，并把 MODEL_DEVICE/MODEL_DTYPE 改为 auto。
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Docker bridge MTU。PPPoE 主机通常为 1492；VPN 环境可按实际链路调低。
DOCKER_NETWORK_MTU=1492
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lecture_math
COLLECTION_MAP_FILE=./config/collections.yaml
GRADE_THRESHOLDS_FILE=./config/grade_thresholds.yaml
MODEL_CACHE_DIR=./models
# mock, deepseek, qwen or openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=mock-teacher
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# GPU 主机建议改为 cuda/bfloat16，并使用 docker-compose.gpu.yml；auto 会在
# 未暴露 GPU 时回退 CPU。
MODEL_DEVICE=auto
MODEL_DTYPE=auto
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_ENABLE_LOCAL_MODELS=true
HF_ENABLE_RERANKER=true
HF_LOCAL_FILES_ONLY=false
OPENAI_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_AGENT_ITERATIONS=3
MAX_TOP_K=32
RETRIEVAL_CANDIDATE_K=16
RERANKER_TOP_K=4
LOG_LEVEL=INFO
REQUEST_CONNECT_TIMEOUT_MS=5000
REQUEST_READ_TIMEOUT_MS=30000
GENERATE_TOTAL_TIMEOUT_MS=120000
COMPUTE_TIMEOUT_MS=3000
MAX_CONTEXT_TOKENS=12000
MAX_UPLOAD_MB=10
MAX_INDEX_FILES=100
# RAG indexing limits (10 GB per file and per request by default).
# MAX_UPLOAD_MB remains intentionally small for /files answer attachments.
MAX_INDEX_FILE_MB=10240
MAX_INDEX_TOTAL_MB=10240
INDEX_TIMEOUT_MS=600000
RAG_CHUNK_CHARS=512
RAG_REGISTRY_FILE=/tmp/agentic_teacher_files/rag_registry.json
LIGHTRAG_WORKING_DIR=/tmp/agentic_teacher_files/lightrag
MODEL_SETTINGS_FILE=/tmp/agentic_teacher_files/model_settings.json
GRADE_THRESHOLD_DEFAULT=0.70
API_AUTH_MODE=none
