QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lecture_math
COLLECTION_MAP_FILE=./config/collections.yaml
GRADE_THRESHOLDS_FILE=./config/grade_thresholds.yaml
MODEL_CACHE_DIR=./models
# mock, deepseek, qwen or openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=mock-teacher
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
MODEL_DEVICE=auto
MODEL_DTYPE=auto
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_ENABLE_LOCAL_MODELS=false
HF_ENABLE_RERANKER=false
HF_LOCAL_FILES_ONLY=false
OPENAI_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
MAX_AGENT_ITERATIONS=3
MAX_TOP_K=15
RETRIEVAL_CANDIDATE_K=15
RERANKER_TOP_K=5
LOG_LEVEL=INFO
REQUEST_CONNECT_TIMEOUT_MS=5000
REQUEST_READ_TIMEOUT_MS=30000
GENERATE_TOTAL_TIMEOUT_MS=120000
COMPUTE_TIMEOUT_MS=3000
MAX_CONTEXT_TOKENS=12000
MAX_UPLOAD_MB=10
MAX_INDEX_FILES=100
# RAG indexing limits (10 GB per file and per request by default).
# MAX_UPLOAD_MB remains intentionally small for /files answer attachments.
MAX_INDEX_FILE_MB=10240
MAX_INDEX_TOTAL_MB=10240
INDEX_TIMEOUT_MS=600000
GRADE_THRESHOLD_DEFAULT=0.70
API_AUTH_MODE=none
